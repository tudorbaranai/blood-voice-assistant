# --- Secrets: never commit ---
.env
*.token
secrets*

# --- Python environment (big, machine-specific, recreated from requirements.txt) ---
.venv/
__pycache__/
*.pyc

# --- Private: raw build logs (contain home network details) ---
docs/history/

# --- Private: recordings of my voice ---
tests/stt/recordings/
tests/stt/mic-*/

# --- Generated audio (recreate with the scripts in tests/tts/) ---
*.wav
*.mp3

# --- Models (e.g. the planned wake-word model, chapter 09) ---
models/

# --- Blood's log (what you said and when: private) ---
logs/

# --- Editor / OS clutter ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Private: my own notes and convenience scripts, kept on my laptop only ---
ROADMAP.md
docs/how-blood-works.html
tools/gaming-mode.*
tools/blood-mode.*

# --- Screen mockups: the work files stay on the laptop (renders, stills, old versions,
#     ~250 MB); the final Eclipse page, its storyboard and the Blender scripts are kept ---
docs/design/manga-v*/*
!docs/design/manga-v3/blood-manga-v3.html
!docs/design/manga-v3/storyboard-eclipse.png
!docs/design/manga-v3/blender/
docs/design/manga-v3/blender/models/
!docs/design/manga-v3/assets/
docs/design/manga-v3/assets/*
!docs/design/manga-v3/assets/hand/
docs/design/manga-v3/assets/hand/*
